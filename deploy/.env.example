# Copy to deploy/.env and adjust.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Public URL agents use to reach the server (shown in install commands).
UEM_PUBLIC_URL=http://localhost

# For production: your domain (Caddy obtains a TLS certificate automatically),
# with UEM_PUBLIC_URL=https://<domain> and UEM_SECURE_COOKIES=true.
UEM_SITE_ADDRESS=:80
UEM_SECURE_COOKIES=false

# Set to false after creating your organization to disable self sign-up.
UEM_ALLOW_SIGNUP=true
