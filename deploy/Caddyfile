# Single entry point: the API, agent gateway, downloads and install scripts go
# to the Go server; everything else is the Next.js console.
# Set UEM_SITE_ADDRESS to your domain (e.g. uem.example.com) for automatic HTTPS.
{$UEM_SITE_ADDRESS::80} {
	encode zstd gzip

	@server path /api/* /downloads/* /install.sh /install.ps1 /healthz
	handle @server {
		reverse_proxy server:8080
	}
	handle {
		reverse_proxy web:3000
	}
}
